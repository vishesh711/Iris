{
  "name": "iris",
  "version": "0.1.0",
  "private": true,
  "description": "Personal agent that holds context durably and acts on it, under supervision.",
  "type": "module",
  "scripts": {
    "dev:bot": "tsx watch src/bot/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:admin": "tsx watch src/admin/server.ts",
    "google:auth-setup": "tsx src/scripts/google-auth-setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "googleapis": "^144.0.0",
    "pg": "^8.12.0",
    "pg-boss": "^10.1.5",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.5"
  }
}

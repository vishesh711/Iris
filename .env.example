TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgres://iris:iris@localhost:55432/iris

# Optional: route capture/approval/brief messages into a Telegram
# supergroup's topics (message threads). Leave unset to use a plain chat.
TELEGRAM_CAPTURE_TOPIC_ID=
TELEGRAM_APPROVALS_TOPIC_ID=
TELEGRAM_BRIEF_TOPIC_ID=

# Where downloaded voice notes, files, and photos are stored.
DATA_DIR=./data/files

# Local Whisper (whisper.cpp-compatible CLI) for voice transcription.
# ffmpeg transcodes Telegram's OGG/Opus voice notes to WAV first.
WHISPER_BINARY_PATH=whisper-cli
WHISPER_MODEL_PATH=
FFMPEG_BINARY_PATH=ffmpeg

# Local Ollama for capture classification, memory extraction, and the
# Ask flow's answers. Using 127.0.0.1 rather than localhost avoids Node
# resolving to the IPv6 loopback (::1), which Ollama doesn't listen on
# by default, causing intermittent ECONNREFUSED errors that have nothing
# to do with whether Ollama is actually running.
# llama3.2 (3B) works for classification/extraction but was unreliable
# on the Ask flow's multi-hop reasoning during Milestone 4 verification
# (e.g. connecting a paid consulting email to "who was the recruiter");
# llama3.1:8b (`ollama pull llama3.1:8b`) answered consistently in
# testing, for a modest RAM/speed cost.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Debug admin UI (recent events, memory inspection).
ADMIN_PORT=4000

# Google OAuth (Gmail + Calendar, read-only). Create a "Desktop app"
# credential in Google Cloud Console — see README for the full setup.
# The refresh token itself is NOT stored here; it lives in the macOS
# Keychain via `npm run google:auth-setup`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your own Telegram chat id with the bot, used only for proactive alerts
# the worker raises on its own (e.g. an expired Google token) — separate
# from normal replies, which don't need this. Message the bot once, then
# find it via: select raw_data->'chat'->>'id' from events where
# source='telegram' order by received_at desc limit 1;
TELEGRAM_OWNER_CHAT_ID=

# Local embedding model for unified search (runs via @xenova/transformers,
# no API cost). Downloads once on first use, cached after that. 384
# dimensions to match the schema's vector(384) columns — changing this
# requires re-embedding everything, not just setting the env var.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
